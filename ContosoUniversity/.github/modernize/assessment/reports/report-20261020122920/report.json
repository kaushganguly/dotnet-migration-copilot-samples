  "security": [
    {
      "id": "CVE-2024-0056",
      "title": "Microsoft.Data.SqlClient and System.Data.SqlClient vulnerable to SQL Data Provider Security Feature Bypass ",
      "category": "CVE",
      "severity": "mandatory",
      "description": "[CVE-2024-0056](https://github.com/advisories/GHSA-98g6-xh36-x2p7): Microsoft.Data.SqlClient and System.Data.SqlClient vulnerable to SQL Data Provider Security Feature Bypass \n\nSeverity: HIGH\n\nAffected dependencies:\n  - Microsoft.Data.SqlClient:2.1.4 (declared at packages.config:14; vulnerable range < 2.1.7; first patched version not specified)\n  - Microsoft.Data.SqlClient:2.1.4 (declared at packages.config:14; vulnerable range >= 3.0.0, < 3.1.5; first patched version not specified)\n  - Microsoft.Data.SqlClient:2.1.4 (declared at packages.config:14; vulnerable range >= 4.0.0, < 4.0.5; first patched version not specified)\n  - Microsoft.Data.SqlClient:2.1.4 (declared at packages.config:14; vulnerable range >= 5.0.0, < 5.1.3; first patched version not specified)\n\nRecommended fix: Upgrade affected dependencies to a patched version or later.",
      "evidence": {
        "files": [
          "packages.config:14"
        ],
        "explanation": "[CVE-2024-0056](https://github.com/advisories/GHSA-98g6-xh36-x2p7): Microsoft.Data.SqlClient and System.Data.SqlClient vulnerable to SQL Data Provider Security Feature Bypass \n\nSeverity: HIGH\n\nAffected dependencies:\n  - Microsoft.Data.SqlClient:2.1.4 (declared at packages.config:14; vulnerable range < 2.1.7; first patched version not specified)\n  - Microsoft.Data.SqlClient:2.1.4 (declared at packages.config:14; vulnerable range >= 3.0.0, < 3.1.5; first patched version not specified)\n  - Microsoft.Data.SqlClient:2.1.4 (declared at packages.config:14; vulnerable range >= 4.0.0, < 4.0.5; first patched version not specified)\n  - Microsoft.Data.SqlClient:2.1.4 (declared at packages.config:14; vulnerable range >= 5.0.0, < 5.1.3; first patched version not specified)\n\nRecommended fix: Upgrade affected dependencies to a patched version or later."
      },
      "storyPoint": 1
    },
    {
      "id": "CWE-682",
      "title": "Incorrect Calculation",
      "category": "Code Quality",
      "severity": "potential",
      "description": "The product performs a calculation that generates incorrect or unintended results that are later used in security-critical decisions or resource management.",
      "evidence": {
        "files": [
          "PaginatedList.cs"
        ],
        "explanation": "PaginatedList.Create multiplies request-derived pageIndex (passed from StudentsController.Index, line 58) by pageSize using 32-bit integer arithmetic at line 27. Extreme or negative page values can overflow and produce an unintended Skip offset, so the computed paging result is not reliable."
      },
      "storyPoint": 5
    },
    {
      "id": "CWE-732",
      "title": "Incorrect Permission Assignment for Critical Resource",
      "category": "Credentials & Secrets",
      "severity": "optional",
      "description": "The product specifies permissions for a security-critical resource in a way that allows that resource to be read or modified by unintended actors.",
      "evidence": {
        "files": [
          "Services/NotificationService.cs"
        ],
        "explanation": "NotificationService creates a message queue and grants MessageQueueAccessRights.FullControl to the Everyone principal at line 23. This allows unintended local actors to read, write, or alter notification messages."
      },
      "storyPoint": 5
    },
    {
      "id": "CWE-22",
      "title": "Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal')",
      "category": "File & Path Security",
      "severity": "optional",
      "description": "The product uses external input to construct a pathname that is intended to identify a file or directory that is located underneath a restricted parent directory, but the product does not properly neutralize special elements within the pathname that can cause the pathname to resolve to a location that is outside of the restricted directory.",
      "evidence": {
        "files": [
          "Controllers/CoursesController.cs"
        ],
        "explanation": "In the POST Edit action, TeachingMaterialImagePath is included in the model binding allowlist, and the value is passed to Server.MapPath at line 172 before the resulting path is deleted at line 175. A crafted relative pathname can therefore escape the intended upload directory."
      },
      "storyPoint": 8
    },
    {
      "id": "CWE-23",
      "title": "Relative Path Traversal",
      "category": "File & Path Security",
      "severity": "optional",
      "description": "The product uses external input to construct a pathname that should be within a restricted directory, but it does not properly neutralize sequences such as .. that can resolve to a location that is outside of that directory.",
      "evidence": {
        "files": [
          "Controllers/CoursesController.cs"
        ],
        "explanation": "The POST Edit action binds TeachingMaterialImagePath from the request and maps it at line 172 without verifying that the resolved path remains under the uploads directory; relative traversal segments can reach other filesystem paths before deletion."
      },
      "storyPoint": 5
    },
    {
      "id": "CWE-36",
      "title": "Absolute Path Traversal",
      "category": "File & Path Security",
      "severity": "optional",
      "description": "The product uses external input to construct a pathname that should be within a restricted directory, but it does not properly neutralize absolute path sequences such as /abs/path that can resolve to a location that is outside of that directory.",
      "evidence": {
        "files": [
          "Controllers/CoursesController.cs"
        ],
        "explanation": "The POST Edit action binds TeachingMaterialImagePath from the request and passes it to Server.MapPath at line 172 without constraining the resolved path. An absolute or rooted path value can cause the subsequent File.Delete call at line 175 to target a path outside the upload directory."
      },
      "storyPoint": 5
    },
    {
      "id": "CWE-434",
      "title": "Unrestricted Upload of File with Dangerous Type",
      "category": "File & Path Security",
      "severity": "mandatory",
      "description": "The product allows the upload or transfer of dangerous file types that are automatically processed within its environment.",
      "evidence": {
        "files": [
          "Controllers/CoursesController.cs"
        ],
        "explanation": "The Create and Edit actions validate uploads only by the client-supplied filename extension at lines 55-60 and 138-143, then save the raw content beneath the web-root Uploads directory at lines 76-87 and 159-180. No content signature or actual file type validation prevents arbitrary content from being stored with an allowed image suffix."
      },
      "storyPoint": 8
    },
    {
      "id": "CWE-502",
      "title": "Deserialization of Untrusted Data",
      "category": "Injection Attacks",
      "severity": "mandatory",
      "description": "The product deserializes untrusted data without sufficiently ensuring that the resulting data will be valid.",
      "evidence": {
        "files": [
          "Services/NotificationService.cs"
        ],
        "explanation": "ReceiveNotification reads the message body from the message queue at line 75 and deserializes it to Notification at line 76 without validating the resulting fields. The service creates the queue with FullControl permissions for Everyone at lines 20-23, allowing untrusted local writers to supply message bodies."
      },
      "storyPoint": 13
    }
  ]
}
