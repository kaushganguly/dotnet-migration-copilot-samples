<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ContosoUniversity</RootNamespace>
    <AssemblyName>ContosoUniversity</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Antlr (3.4.1.9004 in packages.config) was a transitive dependency of the legacy
         System.Web.Razor generator toolchain. ASP.NET Core's Razor/Roslyn pipeline does not
         use it, and no application code references it directly, so it is dropped rather than
         replaced (assessment: NuGet.0001 - no longer needed). -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="MSMQ.Messaging" Version="1.0.4" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />

    <!-- Direct overrides to resolve known vulnerabilities (NU1902/NU1903/NU1904) in
         transitive dependencies pulled in by MSMQ.Messaging (System.Drawing.Common) and
         Microsoft.Data.SqlClient (System.Security.Cryptography.Pkcs). -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.14" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Uploads\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
