<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ContosoUniversity</RootNamespace>
    <AssemblyName>ContosoUniversity</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UserSecretsId>8f1f2c91-8d72-4f8b-9a4a-3b2c5d6e7f8a</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.15" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="MSMQ.Messaging" Version="1.0.4" />
    <!-- Transitive via Microsoft.Data.SqlClient; pinned to a patched version to resolve
         NU1904 (GHSA-rxg9-xrhp-64gj) in the vulnerable 4.7.0 transitive version. -->
    <PackageReference Include="System.Drawing.Common" Version="11.0.0" />
  </ItemGroup>

</Project>
